# ==============================================================================
# Celebrate Bihar • Database & Cloud Infrastructure Configuration
# ==============================================================================

# OPTION 1: Google Cloud Firestore (Recommended Serverless / Real-time Database)
# ------------------------------------------------------------------------------
# In Google Cloud Console or Firebase Console:
# 1. Create a Firebase / Google Cloud Project (e.g. celebrate-bihar)
# 2. Enable Cloud Firestore
# 3. Add your Project ID and API Key below:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# OPTION 2: Supabase / PostgreSQL (SQL Database)
# ------------------------------------------------------------------------------
# In Supabase dashboard (https://supabase.com):
# 1. Create a project and run `schema.sql` in the SQL Editor
# 2. Copy Project URL and API Keys from Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OPTION 3: Direct PostgreSQL Connection (Optional)
DATABASE_URL=postgresql://postgres:password@localhost:5432/celebrate_bihar

# ==============================================================================
# Email & Transactional Dispatch (Optional)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Celebrate Bihar Desk <support@celebratebihar.com>"
ADMIN_EMAIL="operations@celebratebihar.com"
